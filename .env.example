# Meta Model API (server-side only; never expose this key to the browser).
# Leave MECHANISM_AI_META_API_KEY blank to use the deterministic offline fallback.
MECHANISM_AI_META_API_BASE_URL=https://api.meta.ai/v1
MECHANISM_AI_META_MODEL=muse-spark-1.3
MECHANISM_AI_META_API_KEY=
MECHANISM_AI_META_REASONING_EFFORT=minimal
MECHANISM_AI_META_TIMEOUT_SECONDS=45
MECHANISM_AI_META_MAX_RETRIES=1
MECHANISM_AI_META_MAX_OUTPUT_TOKENS=8192

# Runtime
MECHANISM_AI_ARTIFACTS_DIR=./data/artifacts
MECHANISM_AI_MAX_CANDIDATES=3
MECHANISM_AI_CORS_ORIGINS=["http://localhost:5173"]
# auto | reference | mujoco (auto uses MuJoCo when the sim extra is installed)
MECHANISM_AI_SIMULATION_ENGINE=auto

# Docker host ports (change if 8000 or 5173 are already in use)
MECHANISM_AI_API_PORT=8000
MECHANISM_AI_WEB_PORT=5173

# Frontend (optional, defaults to same-origin /api/v1)
# VITE_API_BASE_URL=http://localhost:8000/api/v1
